<Window x:Class="ToDoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ToDoWPF.ViewModels"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:l="clr-namespace:ToDoWPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:ToDoWPF"
        mc:Ignorable="d"
        Height="700" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.Resources>
            <Style TargetType="ListView">
                <Setter Property="Control.FontFamily" Value="Leelawadee UI"/>
                <Setter Property="ContextMenu.FontSize" Value="16"/>
                <Setter Property="Control.FontWeight" Value="Normal"/>
                <Setter Property="Control.Background" Value="#e9e9e9" />
                <Setter Property="Control.Foreground" Value="Black" />
                <Setter Property="ContextMenu.BorderThickness" Value="0"/>
            </Style>

        </Grid.Resources>
        <materialDesign:Card Margin="10" UniformCornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="16*"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="materialDesign:PackIcon">
                        <Setter Property="Width" Value="20"/>
                        <Setter Property="Height" Value="20"/>
                    </Style>
                </Grid.Resources>

                <Grid Grid.ColumnSpan="2">
                    <Border BorderBrush="#f0f0f0" BorderThickness="0 0 0 2">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Background="{x:Null}" Foreground="Black" Margin="0 0 7 0"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:RippleAssist.Feedback="#9F9F9F"
                                    Command="{Binding MinimizeApplicationCommand}">
                                <materialDesign:PackIcon Kind="Minimize"/>
                            </Button>
                            <Button Background="{x:Null}" Foreground="Black" Margin="0 0 7 0"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:RippleAssist.Feedback="#9F9F9F"
                                    Command="{Binding MaximizeApplicationCommand}">
                                <materialDesign:PackIcon Kind="Maximize"/>
                            </Button>
                            <Button Background="#f20000" Foreground="Black" Margin="0 0 7 0"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    materialDesign:RippleAssist.Feedback="Red"
                                    Command="{Binding CloseApplicationCommand}">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <DockPanel Margin="5 5 5 13">
                        <GroupBox DockPanel.Dock="Top" Header="Задачи" Background="#f2f2f2" BorderThickness="0" FontFamily="Leelawadee UI" FontSize="16" FontWeight="Bold">
                            <ListView VerticalAlignment="Top" ItemsSource="{Binding Tasks}" DisplayMemberPath="Title" 
                                       SelectedItem="{Binding SelectedTask}" />
                        </GroupBox>
                        <Button DockPanel.Dock="Bottom" Margin="5 5 0 0" Height="40"
                                Background="#1B75D0" BorderThickness="0"
                                Foreground="White" VerticalAlignment="Bottom"
                                Command="{Binding AddTaskCommand}">
                            <materialDesign:PackIcon HorizontalAlignment="Center" Kind="Add"/>
                        </Button>
                    </DockPanel>
                </Grid>

                <Grid Background="#f9f9f9" Grid.Column="1" Grid.Row="1" Margin="5 5 5 13">
                    <GroupBox Background="#f2f2f2" BorderThickness="0" FontFamily="Leelawadee UI" FontSize="16" FontWeight="Bold"
                              Header="Текущая задача">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">

                                <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                                    <Label Content="Заголовок: "/>
                                    <TextBox SpellCheck.IsEnabled="True" Language="ru-ru" Width="500" Text="{Binding SelectedTask.Title}"/>
                                </StackPanel>

                                <StackPanel Background="AliceBlue" Orientation="Horizontal" Margin="0 20 0 30">
                                    <Label Content="Описание: "/>
                                    <TextBox MaxLines="6" SpellCheck.IsEnabled="True" Language="ru-ru" Width="500" Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                                    <Label Content="Дата создания"/>
                                    <Label Content="{Binding SelectedTask.Created}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                                    <Label Content="Последнее обновление"/>
                                    <Label Content="{Binding SelectedTask.LastUpdated}"/>
                                </StackPanel>

                                <StackPanel Margin="0 100 0 10" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox IsChecked="{Binding SelectedTask.IsCompleted}" IsThreeState="True" />
                                    <Label Content="Выполнено"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 10">
                                <Button Margin="0 0 15 0" Height="40" Width="75"
                                            Background="#1B75D0"
                                            Command="{Binding PutTaskCommand}">
                                    <materialDesign:PackIcon Kind="ContentSave"/>
                                </Button>
                                <Button Background="#e30000" Height="40"
                                            Command="{Binding DeleteTaskCommand}">
                                    <materialDesign:PackIcon Kind="TrashCan"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </Grid>  
        </materialDesign:Card>
    </Grid>
</Window>
